# Paid model calls (optional; omit when using --no-model)
ANTHROPIC_API_KEY=

# Live Ambiguous workspace (only needed with --live)
AMBIGUOUS_API_KEY=
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp

# Agent-authored posts. Verifier and Closer fail closed unless their own
# token or the Desk token is configured.
AMBIGUOUS_TOKEN_OPS=
AMBIGUOUS_TOKEN_INBOX=
AMBIGUOUS_TOKEN_FOLLOWUP=
AMBIGUOUS_TOKEN_DESK=
AMBIGUOUS_TOKEN_VERIFIER=
AMBIGUOUS_TOKEN_CLOSER=

# Optional behavior; all are off by default.
FLOOR_SAFETY_DEMO=0
FLOOR_TIMELINE=0
FLOOR_REPLY_LOOP=0
# FLOOR_TIMELINE_PATH=/absolute/path/to/timeline.json
